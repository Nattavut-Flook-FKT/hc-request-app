rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────

    // ตรวจ email domain @freshket.co
    function isFreshket() {
      return request.auth != null && request.auth.token.email.matches('.*@freshket\\.co$');
    }

    // ตรวจ role == 'admin' จาก Firestore users collection
    function isAdmin() {
      return isFreshket() &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }

    // ตรวจ role == 'ta' หรือ 'admin'
    function isTA() {
      return isFreshket() &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['ta', 'admin'];
    }

    // ── Users collection ───────────────────────────────────────────────────────
    // อ่านได้ทุก freshket user
    // create: เฉพาะ admin หรือ self-registration (user สร้าง doc ตัวเองครั้งแรกด้วย
    //   role 'pending' เท่านั้น — กัน privilege escalation, เปลี่ยน role จริงทำได้แค่ admin)
    // update/delete: admin เท่านั้น
    match /users/{userId} {
      allow read: if isFreshket();
      allow create: if isAdmin() ||
        (isFreshket() && request.auth.token.email == userId && request.resource.data.role == 'pending');
      allow update, delete: if isAdmin();
    }

    // ── HC Requests collection ─────────────────────────────────────────────────
    // create: freshket user ทุกคน (Manager ยื่น request)
    // update: freshket user ทุกคน (TA/Manager แก้ status) หรือ unauthenticated ที่มี
    //   approvalToken ตรง (CEO approve/reject ผ่านลิงก์ Slack — beta, ดู PendingApproval)
    // get (doc เดียว): freshket user ทุกคน หรือ unauthenticated เฉพาะ doc ที่ PendingApproval
    //   → หน้า /approve/:id/:token โชว์สรุปคำขอได้โดยไม่ต้อง login (ต้องรู้ doc id 20-char random)
    // list (query): freshket เท่านั้น — สำคัญ: กันคนนอกรัน query where status==PendingApproval
    //   แล้ว enumerate คำขอ pending ทั้งหมด (ถ้าใช้ allow read รวมกันจะรั่วออกอินเทอร์เน็ต)
    // delete: admin เท่านั้น (ป้องกันการลบ record โดยไม่ได้รับอนุญาต)
    match /hc_requests/{docId} {
      allow get:  if isFreshket() || resource.data.status == 'PendingApproval';
      allow list: if isFreshket();
      allow create: if isFreshket();
      allow update: if isFreshket() || (
        resource.data.status == 'PendingApproval'
        && 'approvalToken' in resource.data
        && request.resource.data.approvalToken == resource.data.approvalToken
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvalToken', 'approvedAt', 'rejectReason', 'rejectedAt'])
        && request.resource.data.status in ['Open', 'RejectedByCEO']
      );
      allow delete: if isAdmin();
    }

    // Sub-collections ของ hc_requests (comments, cv files etc.)
    match /hc_requests/{docId}/{subcol=**} {
      allow read:   if isFreshket();
      allow create: if isFreshket();
      allow update: if isFreshket();
      allow delete: if isAdmin();
    }

    // ── HC Logs ────────────────────────────────────────────────────────────────
    // อ่านได้ admin + TA, เขียน (append only) ได้ freshket user
    // delete ได้เฉพาะ admin (bulk clear ผ่าน Admin Tools)
    match /hc_logs/{logId} {
      allow read:   if isTA();
      allow create: if isFreshket();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Custom Positions ───────────────────────────────────────────────────────
    match /custom_positions/{docId} {
      allow read:           if isFreshket();
      allow create:         if isFreshket();
      allow update, delete: if isAdmin();
    }

    // ── JD Library ─────────────────────────────────────────────────────────────
    // อ่านได้ทุก freshket user (Manager ใช้ดู JD suggestion ตอนยื่นคำขอ)
    // เขียน/แก้ไข/ลบ ได้เฉพาะ admin เท่านั้น
    match /jd_library/{docId} {
      allow read:               if isFreshket();
      allow create, update, delete: if isAdmin();
    }

    // ── Settings (Maintenance Mode etc.) ──────────────────────────────────────
    // อ่านได้เฉพาะ freshket user, admin เท่านั้นเขียนได้
    // เดิมเป็น `request.auth != null` ซึ่งกว้างกว่าทุก block ในไฟล์นี้ — การกันโดเมน
    // อยู่ที่ Login.jsx (signOut ฝั่ง client หลัง sign-in สำเร็จ) แปลว่า token ของบัญชี
    // นอกโดเมนเกิดขึ้นจริงและยิง Firestore ได้ก่อนถูกเตะออก จึงต้องปิดที่ rules ด้วย
    // ปลอดภัยกับแอป: App.jsx subscribe settings/maintenance หลัง auth (`if (!user) return`)
    // ไม่มี path ไหนอ่าน settings ก่อน login
    match /settings/{docId} {
      allow read:  if isFreshket();
      allow write: if isAdmin();
    }

    // ── Meta (HCID Counter — legacy) ──────────────────────────────────────────
    // freshket user ทุกคนต้องเขียนได้ เพราะ generateHCID() ใช้ transaction
    // แต่ limit ให้เฉพาะ document 'hcid_counter'
    match /meta/hcid_counter {
      allow read, write: if isFreshket();
    }

    // meta document อื่นๆ นอกจาก hcid_counter — admin เท่านั้น
    match /meta/{docId} {
      allow read:  if isFreshket();
      allow write: if isAdmin();
    }

    // ── Counters (HCID per-year atomic counter) ───────────────────────────────
    // ใช้โดย generateHCID() (transaction) และ fixDuplicateHCIDs() (admin)
    // freshket user ทุกคนอ่าน/เขียนได้ เพราะ Manager ยื่นฟอร์มใช้ generateHCID()
    match /counters/{docId} {
      allow read, write: if isFreshket();
    }
  }
}
